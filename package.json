{
  "name": "project-logbook",
  "private": true,
  "version": "1.0.0",
  "description": "Capture project work as you do it, link it to a Gantt chart, and generate weekly log book pages.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "seed": "node scripts/seed.ts",
    "lock": "node scripts/lock.ts",
    "prepare": "node scripts/setup-git.mjs"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "dompurify": "^3.4.16",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
